{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "services": {
    "web": { "root": "web/" },
    "api": {
      "root": "backend/",
      "entrypoint": "server:app",
      "functions": {
        "server.py": { "excludeFiles": ".venv/**" }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
